{
  "compilerOptions": {
    "experimentalDecorators": true,
    "lib": ["ES6", "dom"],
    "target": "ES2022",
    "module": "NodeNext",
    "moduleResolution": "nodenext",
    "baseUrl": ".",
    "paths": {
      "baseball-sim-engine": ["src/baseball-sim-engine/index.ts"],
      "baseball-sim-engine/*": ["src/baseball-sim-engine/*"]
    },
    "types": ["reflect-metadata", "node", "mocha"],
    "skipLibCheck": true,
    "resolveJsonModule": true,
    "declaration": true,
    "emitDecoratorMetadata": true,
    "esModuleInterop": true,
    "outDir": "./dist",
    "sourceMap": true,
    "allowSyntheticDefaultImports": true
  },
  "include": ["src"],
  "exclude": ["node_modules"]
}